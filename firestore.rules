rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar si el usuario es un administrador autorizado
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'josegonzalez.private@gmail.com' ||
         request.auth.token.email == 'santopadrevzla@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // NOTA: la colección 'usuarios/{uid}' del feature de wallet no se usa en ningún
    // lugar del código (js/modules/wallet.js, functions/rewards.js y functions/referrals.js
    // leen y escriben todos en 'users/{uid}'). Se elimina para no dejar una colección
    // abierta sin protección. Ver checklist T01b para la validación granular pendiente
    // de 'users/{userId}' (delta de points/stamps/isVip/activeRewards).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();

      match /transactions/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read, write: if isAdmin();
      }
    }

    // Reglas para la colección de órdenes (pedidos/canjes)
    match /orders/{orderId} {
      allow create: if (request.auth != null && request.resource.data.userId == request.auth.uid) || isAdmin();
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Reglas para la colección de auditoría
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
