rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Función auxiliar para verificar si el usuario es un administrador autorizado
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'josegonzalez.private@gmail.com' ||
         request.auth.token.email == 'santopadrevzla@gmail.com' ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // NOTA: la colección 'usuarios/{uid}' del feature de wallet no se usa en ningún
    // lugar del código (js/modules/wallet.js, functions/rewards.js y functions/referrals.js
    // leen y escriben todos en 'users/{uid}'). Se elimina para no dejar una colección
    // abierta sin protección.
    function protectedUserFields() {
      return [
        'points',
        'stamps',
        'isVip',
        'referredBy',
        'referralStatus',
        'activeRewards',
        'claimedRewards',
        'usdcBalance',
        'pointsExpiresAt',
        'pointsLastActivityAt',
        'reconciliationStatus',
        'lastReconciledAt'
      ];
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isAdmin();

      // El saldo inicial lo otorga Auth onCreate/syncUserProfile con Admin SDK.
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        !request.resource.data.keys().hasAny(protectedUserFields());

      // El usuario solo puede editar perfil/evidencia; saldos y recompensas son server-side.
      allow update: if isAdmin() || (
        request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields())
      );

      allow delete: if isAdmin();

      match /transactions/{txId} {
        allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
        allow write: if false;
      }
    }

    // Reglas para la colección de órdenes (pedidos/canjes)
    match /orders/{orderId} {
      allow create: if isAdmin() || (
        request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending_confirmation' &&
        request.resource.data.pointsEarned == 0
      );
      allow read: if (request.auth != null && resource.data.userId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Reglas para la colección de auditoría
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /referralClaims/{claimId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rateLimits/{limitId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /tierRewards/{tierId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /loyaltyCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /loyalty_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /loyaltyLedger/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /loyaltyReconciliations/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /loyaltyJobState/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Configuración pública de solo-lectura (ej. config/marketing: URL del webhook de
    // n8n/Sheets que dashboard.js consulta). Solo un admin la edita desde admin.html.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Lista extendida de administradores (admin.html -> checkIsAdmin lee esto para
    // cualquier email que no esté hardcodeado en isAdmin()). Sin esta regla, esa
    // lectura fallaba en silencio (capturada por un try/catch) para cualquier admin
    // agregado solo por esta colección.
    match /admins/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if isAdmin();
    }
  }
}
